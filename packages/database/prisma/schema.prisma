datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
    output   = "./generated/client"
}

generator zod {
    provider = "prisma-zod-generator"
    output   = "./zod"
    config   = "./zod-generator.config.json"
}

model User {
    id                 String       @id @default(cuid())
    name               String
    email              String
    emailVerified      Boolean
    image              String?
    createdAt          DateTime
    updatedAt          DateTime
    username           String?
    role               String?
    banned             Boolean?
    banReason          String?
    banExpires         DateTime?
    onboardingComplete Boolean      @default(false)
    paymentsCustomerId String?
    locale             String?
    twoFactorEnabled   Boolean?
    aiOptOut           Boolean      @default(false)
    sessions           Session[]
    accounts           Account[]
    passkeys           Passkey[]
    invitations        Invitation[]
    purchases          Purchase[]
    members            Member[]
    twofactors         TwoFactor[]
    aiChats            AiChat[]
    auditLogs          AuditLog[]
    managedWarehouses  Warehouse[]
    tasksAssigned      Task[]       @relation("TaskAssignedTo")
    tasksCreated       Task[]       @relation("TaskAssignedBy")

    @@unique([email])
    @@unique([username])
    @@map("user")
}

model Session {
    id        String   @id @default(cuid())
    expiresAt DateTime
    ipAddress String?
    userAgent String?
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    impersonatedBy String?

    activeOrganizationId String?

    token     String
    createdAt DateTime
    updatedAt DateTime

    @@unique([token])
    @@map("session")
}

model Account {
    id           String    @id @default(cuid())
    accountId    String
    providerId   String
    userId       String
    user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    accessToken  String?   @db.Text
    refreshToken String?   @db.Text
    idToken      String?   @db.Text
    expiresAt    DateTime?
    password     String?

    accessTokenExpiresAt  DateTime?
    refreshTokenExpiresAt DateTime?
    scope                 String?
    createdAt             DateTime
    updatedAt             DateTime

    @@map("account")
}

model Verification {
    id         String   @id @default(cuid())
    identifier String
    value      String   @db.Text
    expiresAt  DateTime

    createdAt DateTime?
    updatedAt DateTime?

    @@map("verification")
}

model Passkey {
    id           String    @id @default(cuid())
    name         String?
    publicKey    String
    userId       String
    user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    credentialID String
    counter      Int
    deviceType   String
    backedUp     Boolean
    transports   String?
    createdAt    DateTime?

    @@map("passkey")
}

model TwoFactor {
    id          String @id @default(cuid())
    secret      String
    backupCodes String
    userId      String
    user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@map("twoFactor")
}

model Organization {
    id                 String       @id @default(cuid())
    name               String
    slug               String?
    logo               String?
    createdAt          DateTime
    metadata           String?
    paymentsCustomerId String?
    members            Member[]
    invitations        Invitation[]
    purchases          Purchase[]
    aiChats            AiChat[]
    roleGroups         RoleGroup[]

    @@unique([slug])
    @@map("organization")
}

model Member {
    id             String       @id @default(cuid())
    organizationId String
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    userId         String
    user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
    role           String
    createdAt      DateTime

    @@unique([organizationId, userId])
    @@map("member")
}

model Invitation {
    id             String       @id @default(cuid())
    organizationId String
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    email          String
    role           String?
    status         String
    expiresAt      DateTime
    inviterId      String
    user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

    @@map("invitation")
}

enum PurchaseType {
    SUBSCRIPTION
    ONE_TIME
}

model Purchase {
    id             String        @id @default(cuid())
    organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    organizationId String?
    user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId         String?
    type           PurchaseType
    customerId     String
    subscriptionId String?       @unique
    productId      String
    status         String?
    createdAt      DateTime      @default(now())
    updatedAt      DateTime      @updatedAt

    @@index([subscriptionId])
    @@map("purchase")
}

model AiChat {
    id             String        @id @default(cuid())
    organizationId String?
    organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    userId         String?
    user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
    title          String?
    /// [ChatMessages]
    messages       Json          @default("[]")
    createdAt      DateTime      @default(now())
    updatedAt      DateTime      @updatedAt

    @@map("ai_chat")
}

model NoteTag {
    id        String   @id @default(cuid())
    name      String
    notes     Note[]
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("note_tag")
}

model Note {
    id          String   @id @default(cuid())
    title       String
    content     Json
    imageUrl    String?
    description String?
    published   Boolean  @default(false)
    noteTagId   String
    noteTag     NoteTag  @relation(fields: [noteTagId], references: [id], onDelete: Cascade)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@map("note")
}

model AuditLog {
    id         String   @id @default(cuid())
    userId     String?
    user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
    action     String
    resource   String
    resourceId String?
    metadata   Json?
    ipAddress  String?
    userAgent  String?
    createdAt  DateTime @default(now())

    @@map("audit_log")
}

model Fell {
    id        String   @id @default(cuid())
    name      String
    weather   String
    content   Json
    imageUrl  String?
    published Boolean  @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("fell")
}

model Picture {
    id          String   @id @default(cuid())
    name        String
    title       String
    description String?
    imageUrl    String?
    published   Boolean  @default(false)
    likes       Int      @default(0)
    views       Int      @default(0)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@map("picture")
}

// ================================================
// Scope Models
// ================================================

model RoleGroup {
    id             String       @id @default(cuid())
    createdAt      DateTime     @default(now())
    updatedAt      DateTime     @updatedAt
    organizationId String
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    name           String
    description    String
    warehouses     Warehouse[]
    roles          String[]

    @@map("role_group")
}

// ================================================
// Common Models
// ================================================
model Address {
    id           String   @id @default(cuid())
    addressLine1 String
    addressLine2 String?
    city         String
    country      String
    state        String
    zip          String
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    warehouse       Warehouse?          @relation("WarehouseAddress")
    warehouseReturn Warehouse?          @relation("WarehouseReturnAddress")
    orgConfig       OrganizationConfig? @relation("OrgConfigHeadquarter")

    @@map("address")
}

model Task {
    id           String   @id @default(cuid())
    description  String
    assignedToId String
    assignedTo   User     @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
    assignedById String
    assignedBy   User     @relation("TaskAssignedBy", fields: [assignedById], references: [id])
    deadline     DateTime
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    @@map("task")
}

model Barcode {
    id        String   @id @default(cuid())
    metadata  Json
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("barcode")
}

// ================================================
// Functional Models.
// ================================================

model OrganizationConfig {
    id             String   @id @default(cuid())
    headquarterId  String   @unique
    headquarter    Address  @relation("OrgConfigHeadquarter", fields: [headquarterId], references: [id])
    fullfilment    Json
    inventory      Json
    units          Json
    barcodeScanner Json
    purchaseOrders Json
    transfers      Json
    cycleCount     Json
    dataRetention  Json
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    @@map("organization_config")
}

model Warehouse {
    id              String     @id @default(cuid())
    name            String
    prefix          String
    phone           String
    managerId       String
    manager         User       @relation(fields: [managerId], references: [id])
    addressId       String     @unique
    address         Address    @relation("WarehouseAddress", fields: [addressId], references: [id])
    returnAddressId String     @unique
    returnAddress   Address    @relation("WarehouseReturnAddress", fields: [returnAddressId], references: [id])
    roleGroupId     String?
    roleGroup       RoleGroup? @relation(fields: [roleGroupId], references: [id])
    createdAt       DateTime   @default(now())
    updatedAt       DateTime   @updatedAt

    @@map("warehouse")
}

model Shelf {
    id          String    @id @default(cuid())
    name        String
    description String
    startX      Float
    startY      Float
    length      Float
    width       Float
    height      Float
    isObstacle  Boolean
    pickSides   Boolean[]
    bins        Bin[]
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    @@map("shelf")
}

model Area {
    id          String   @id @default(cuid())
    name        String
    description String
    startX      Float
    startY      Float
    length      Float
    width       Float
    isObstacle  Boolean
    color       String
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@map("area")
}

model Bin {
    id          String   @id @default(cuid())
    name        String
    description String
    shelfId     String
    shelf       Shelf    @relation(fields: [shelfId], references: [id])
    level       Int
    isPickable  Boolean
    startX      Float
    startY      Float
    length      Float
    width       Float
    height      Float
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@map("bin")
}

model Border {
    id        String   @id @default(cuid())
    name      String
    startX    Float
    startY    Float
    endX      Float
    endY      Float
    type      String // Wall | Door
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("border")
}

