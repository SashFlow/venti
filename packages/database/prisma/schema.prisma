// ============================================================================
// ENTERPRISE WMS SCHEMA (V2)
// Designed For:
// - Multi Tenant SaaS
// - High Scale Warehousing
// - HVAC / Distribution / 3PL
// - Batch + Serialized Inventory
// - Directed Putaway
// - Wave Picking
// - Replenishment
// - Event Sourcing
// ============================================================================

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

// ============================================================================
// ORGANIZATION
// ============================================================================

model Organization {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    name String
    slug String @unique

    warehouses Warehouse[]
    users      User[]
    products   Product[]
    suppliers  Supplier[]
    customers  Customer[]
}

// ============================================================================
// USER
// ============================================================================

model User {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    organizationId String
    organization   Organization @relation(fields: [organizationId], references: [id])

    name  String
    email String

    role UserRole

    inventoryTransactions InventoryTransaction[]
    tasks                 WarehouseTask[]

    @@unique([organizationId, email])
}

enum UserRole {
    ADMIN
    SUPERVISOR
    OPERATOR
    PICKER
    PACKER
    RECEIVER
}

// ============================================================================
// WAREHOUSE
// ============================================================================

model Warehouse {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    organizationId String
    organization   Organization @relation(fields: [organizationId], references: [id])

    code String
    name String

    timezone String @default("UTC")

    status WarehouseStatus @default(ACTIVE)

    locations Location[]

    inventoryBalances InventoryBalance[]

    receivingOrders ReceivingOrder[]
    salesOrders     SalesOrder[]
    shipments       Shipment[]

    tasks WarehouseTask[]

    @@unique([organizationId, code])
}

enum WarehouseStatus {
    ACTIVE
    INACTIVE
    MAINTENANCE
}

// ============================================================================
// LOCATION TREE
// ============================================================================

model Location {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    warehouseId String
    warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

    parentLocationId String?
    parentLocation   Location? @relation("LocationHierarchy", fields: [parentLocationId], references: [id])

    children Location[] @relation("LocationHierarchy")

    code String
    name String?

    type LocationType

    barcode String? @unique

    sequence Int?

    isPickable   Boolean @default(true)
    isReceivable Boolean @default(true)
    isReservable Boolean @default(true)
    isQuarantine Boolean @default(false)

    capacityVolume Decimal? @db.Decimal(18, 4)
    capacityWeight Decimal? @db.Decimal(18, 4)

    currentVolume Decimal? @db.Decimal(18, 4)
    currentWeight Decimal? @db.Decimal(18, 4)

    x Decimal? @db.Decimal(12, 2)
    y Decimal? @db.Decimal(12, 2)
    z Decimal? @db.Decimal(12, 2)

    width  Decimal?
    height Decimal?
    depth  Decimal?

    rotationX Decimal?
    rotationY Decimal?
    rotationZ Decimal?

    meshType String?
    colorHex String?

    inventoryBalances InventoryBalance[]

    fromTransactions InventoryTransaction[] @relation("TransactionFromLocation")
    toTransactions   InventoryTransaction[] @relation("TransactionToLocation")

    replenishmentRules ReplenishmentRule[]

    @@unique([warehouseId, code])
    @@index([warehouseId, type])
    @@index([parentLocationId])
}

enum LocationType {
    FLOOR
    ZONE
    AISLE
    RACK
    SHELF
    BIN
    PALLET
    DOCK
    STAGING
    PACKING
    QC
    QUARANTINE
}

// ============================================================================
// PRODUCT
// ============================================================================

model Product {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    organizationId String
    organization   Organization @relation(fields: [organizationId], references: [id])

    code String
    name String

    description String?

    isPerishable    Boolean @default(false)
    isBatchTracked  Boolean @default(false)
    isSerialTracked Boolean @default(false)

    skus SKU[]

    @@unique([organizationId, code])
}

// ============================================================================
// SKU
// ============================================================================

model SKU {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    productId String
    product   Product @relation(fields: [productId], references: [id])

    code String
    name String

    barcode String?

    width  Decimal? @db.Decimal(12, 2)
    height Decimal? @db.Decimal(12, 2)
    length Decimal? @db.Decimal(12, 2)
    weight Decimal? @db.Decimal(12, 2)

    baseUomId String
    baseUom   UnitOfMeasure @relation(fields: [baseUomId], references: [id])

    unitPrice Decimal? @db.Decimal(18, 4)

    balances InventoryBalance[]
    serials  InventorySerial[]
    lots     InventoryLot[]

    reservations InventoryReservation[]

    purchaseOrderItems PurchaseOrderItem[]
    salesOrderItems    SalesOrderItem[]

    @@unique([productId, code])
}

// ============================================================================
// UOM
// ============================================================================

model UnitOfMeasure {
    id   String @id @default(cuid())
    code String @unique
    name String

    skus SKU[]
}

model SKUUomConversion {
    id String @id @default(cuid())

    skuId String
    sku   SKU    @relation(fields: [skuId], references: [id])

    fromUomId String
    fromUom   UnitOfMeasure @relation("FromUom", fields: [fromUomId], references: [id])

    toUomId String
    toUom   UnitOfMeasure @relation("ToUom", fields: [toUomId], references: [id])

    multiplier Decimal @db.Decimal(18, 6)

    @@unique([skuId, fromUomId, toUomId])
}

// ============================================================================
// LOT / BATCH
// ============================================================================

model InventoryLot {
    id String @id @default(cuid())

    skuId String
    sku   SKU    @relation(fields: [skuId], references: [id])

    lotNumber String

    manufactureDate DateTime?
    expiryDate      DateTime?

    qcStatus QCStatus @default(PENDING)

    balances InventoryBalance[]

    @@unique([skuId, lotNumber])
}

enum QCStatus {
    PENDING
    PASSED
    FAILED
    HOLD
}

// ============================================================================
// SERIAL TRACKING
// ============================================================================

model InventorySerial {
    id String @id @default(cuid())

    skuId String
    sku   SKU    @relation(fields: [skuId], references: [id])

    serialNumber String

    locationId String?
    location   Location? @relation(fields: [locationId], references: [id])

    status InventoryStatus

    @@unique([skuId, serialNumber])
}

// ============================================================================
// INVENTORY BALANCE
// ============================================================================

model InventoryBalance {
    id String @id @default(cuid())

    warehouseId String
    warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

    locationId String
    location   Location @relation(fields: [locationId], references: [id])

    skuId String
    sku   SKU    @relation(fields: [skuId], references: [id])

    lotId String?
    lot   InventoryLot? @relation(fields: [lotId], references: [id])

    quantityAvailable Decimal @default(0) @db.Decimal(18, 4)
    quantityReserved  Decimal @default(0) @db.Decimal(18, 4)
    quantityDamaged   Decimal @default(0) @db.Decimal(18, 4)
    quantityInbound   Decimal @default(0) @db.Decimal(18, 4)

    updatedAt DateTime @updatedAt

    @@unique([locationId, skuId, lotId])
    @@index([warehouseId, skuId])
    @@index([locationId, skuId])
}

// ============================================================================
// INVENTORY RESERVATIONS
// ============================================================================

model InventoryReservation {
    id String @id @default(cuid())

    skuId String
    sku   SKU    @relation(fields: [skuId], references: [id])

    salesOrderItemId String?
    salesOrderItem   SalesOrderItem? @relation(fields: [salesOrderItemId], references: [id])

    quantity Decimal @db.Decimal(18, 4)

    status ReservationStatus

    createdAt DateTime @default(now())

    @@index([skuId])
}

enum ReservationStatus {
    ACTIVE
    RELEASED
    CONSUMED
}

// ============================================================================
// INVENTORY EVENT SOURCING
// ============================================================================

model InventoryTransaction {
    id String @id @default(cuid())

    createdAt DateTime @default(now())

    warehouseId String
    warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

    skuId String
    sku   SKU    @relation(fields: [skuId], references: [id])

    lotId String?
    lot   InventoryLot? @relation(fields: [lotId], references: [id])

    fromLocationId String?
    fromLocation   Location? @relation("TransactionFromLocation", fields: [fromLocationId], references: [id])

    toLocationId String?
    toLocation   Location? @relation("TransactionToLocation", fields: [toLocationId], references: [id])

    quantity Decimal @db.Decimal(18, 4)

    transactionType InventoryTransactionType

    referenceType String?
    referenceId   String?

    performedById String?
    performedBy   User?   @relation(fields: [performedById], references: [id])

    metadata Json?

    @@index([warehouseId, createdAt])
    @@index([skuId, createdAt])
    @@index([transactionType])
}

enum InventoryTransactionType {
    RECEIVE
    PUTAWAY
    PICK
    PACK
    SHIP
    MOVE
    ADJUSTMENT
    CYCLE_COUNT
    RETURN
    DAMAGE
    REPLENISHMENT
}

// ============================================================================
// SUPPLIERS
// ============================================================================

model Supplier {
    id String @id @default(cuid())

    organizationId String
    organization   Organization @relation(fields: [organizationId], references: [id])

    code String
    name String

    purchaseOrders PurchaseOrder[]

    @@unique([organizationId, code])
}

// ============================================================================
// PURCHASE ORDER
// ============================================================================

model PurchaseOrder {
    id String @id @default(cuid())

    warehouseId String
    warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

    supplierId String
    supplier   Supplier @relation(fields: [supplierId], references: [id])

    poNumber String

    status PurchaseOrderStatus

    expectedAt DateTime?

    items PurchaseOrderItem[]

    createdAt DateTime @default(now())

    @@unique([warehouseId, poNumber])
}

enum PurchaseOrderStatus {
    DRAFT
    APPROVED
    IN_TRANSIT
    PARTIAL
    RECEIVED
    CANCELLED
}

model PurchaseOrderItem {
    id String @id @default(cuid())

    purchaseOrderId String
    purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

    skuId String
    sku   SKU    @relation(fields: [skuId], references: [id])

    orderedQty  Decimal @db.Decimal(18, 4)
    receivedQty Decimal @default(0) @db.Decimal(18, 4)

    unitPrice Decimal? @db.Decimal(18, 4)
}

// ============================================================================
// RECEIVING
// ============================================================================

model ReceivingOrder {
    id String @id @default(cuid())

    warehouseId String
    warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

    purchaseOrderId String?
    purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

    status ReceivingStatus

    receivedAt DateTime?

    createdAt DateTime @default(now())
}

enum ReceivingStatus {
    PENDING
    RECEIVING
    COMPLETED
    CANCELLED
}

// ============================================================================
// CUSTOMERS
// ============================================================================

model Customer {
    id String @id @default(cuid())

    organizationId String
    organization   Organization @relation(fields: [organizationId], references: [id])

    code String
    name String

    salesOrders SalesOrder[]

    @@unique([organizationId, code])
}

// ============================================================================
// SALES ORDER
// ============================================================================

model SalesOrder {
    id String @id @default(cuid())

    warehouseId String
    warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

    customerId String
    customer   Customer @relation(fields: [customerId], references: [id])

    orderNumber String

    status SalesOrderStatus

    orderedAt DateTime @default(now())

    items SalesOrderItem[]

    shipment Shipment?

    @@unique([warehouseId, orderNumber])
}

enum SalesOrderStatus {
    DRAFT
    ALLOCATED
    PICKING
    PACKING
    SHIPPED
    CANCELLED
}

model SalesOrderItem {
    id String @id @default(cuid())

    salesOrderId String
    salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id])

    skuId String
    sku   SKU    @relation(fields: [skuId], references: [id])

    orderedQty   Decimal @db.Decimal(18, 4)
    allocatedQty Decimal @default(0) @db.Decimal(18, 4)
    pickedQty    Decimal @default(0) @db.Decimal(18, 4)

    reservations InventoryReservation[]
}

// ============================================================================
// WAVE PICKING
// ============================================================================

model PickWave {
    id String @id @default(cuid())

    warehouseId String
    warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

    waveNumber String

    status WaveStatus

    tasks WarehouseTask[]

    createdAt DateTime @default(now())

    @@unique([warehouseId, waveNumber])
}

enum WaveStatus {
    CREATED
    RELEASED
    PICKING
    COMPLETED
}

// ============================================================================
// SHIPMENT
// ============================================================================

model Shipment {
    id String @id @default(cuid())

    warehouseId String
    warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

    salesOrderId String     @unique
    salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id])

    trackingNumber String?

    carrier String?

    shippedAt DateTime?

    status ShipmentStatus
}

enum ShipmentStatus {
    PENDING
    PACKED
    SHIPPED
    DELIVERED
    FAILED
}

// ============================================================================
// TASK ENGINE
// ============================================================================

model WarehouseTask {
    id String @id @default(cuid())

    warehouseId String
    warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

    assignedUserId String?
    assignedUser   User?   @relation(fields: [assignedUserId], references: [id])

    pickWaveId String?
    pickWave   PickWave? @relation(fields: [pickWaveId], references: [id])

    type WarehouseTaskType

    status TaskStatus

    priority TaskPriority

    fromLocationId String?
    fromLocation   Location? @relation("TaskFromLocation", fields: [fromLocationId], references: [id])

    toLocationId String?
    toLocation   Location? @relation("TaskToLocation", fields: [toLocationId], references: [id])

    skuId String?
    sku   SKU?    @relation(fields: [skuId], references: [id])

    quantity Decimal? @db.Decimal(18, 4)

    startedAt   DateTime?
    completedAt DateTime?

    createdAt DateTime @default(now())

    @@index([warehouseId, status])
    @@index([assignedUserId, status])
}

enum WarehouseTaskType {
    RECEIVE
    PUTAWAY
    PICK
    PACK
    SHIP
    MOVE
    REPLENISHMENT
    CYCLE_COUNT
}

enum TaskStatus {
    PENDING
    ASSIGNED
    IN_PROGRESS
    COMPLETED
    CANCELLED
}

enum TaskPriority {
    LOW
    NORMAL
    HIGH
    URGENT
}

// ============================================================================
// REPLENISHMENT
// ============================================================================

model ReplenishmentRule {
    id String @id @default(cuid())

    locationId String
    location   Location @relation(fields: [locationId], references: [id])

    skuId String
    sku   SKU    @relation(fields: [skuId], references: [id])

    minQty       Decimal @db.Decimal(18, 4)
    maxQty       Decimal @db.Decimal(18, 4)
    replenishQty Decimal @db.Decimal(18, 4)

    @@unique([locationId, skuId])
}

// ============================================================================
// CYCLE COUNT
// ============================================================================

model CycleCountSession {
    id String @id @default(cuid())

    warehouseId String
    warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

    status CycleCountStatus

    createdAt DateTime @default(now())

    items CycleCountItem[]
}

enum CycleCountStatus {
    CREATED
    COUNTING
    APPROVED
    COMPLETED
}

model CycleCountItem {
    id String @id @default(cuid())

    sessionId String
    session   CycleCountSession @relation(fields: [sessionId], references: [id])

    locationId String
    location   Location @relation(fields: [locationId], references: [id])

    skuId String
    sku   SKU    @relation(fields: [skuId], references: [id])

    expectedQty Decimal @db.Decimal(18, 4)
    countedQty  Decimal @db.Decimal(18, 4)

    variance Decimal @db.Decimal(18, 4)
}
