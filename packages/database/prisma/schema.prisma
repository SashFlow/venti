// ============================================================================
// ENTERPRISE WMS PLATFORM SCHEMA (V3)
// PURPOSE:
// - Enterprise WMS POC
// - Reverse Logistics
// - Workflow Engine
// - 3D Warehouse Rendering
// - React Flow Workflow Visualization
// - Digital Twin Ready
// - Multi Tenant SaaS
// ============================================================================

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
    output   = "./generated/client"
}

generator zod {
    provider = "prisma-zod-generator"
    output   = "./zod"
    config   = "./zod-generator.config.json"
}

// ============================================================================
// ROOT
// ============================================================================

model User {
    id                    String                 @id @default(cuid())
    name                  String
    email                 String
    emailVerified         Boolean
    image                 String?
    createdAt             DateTime
    updatedAt             DateTime
    username              String?
    role                  String?
    banned                Boolean?
    banReason             String?
    banExpires            DateTime?
    onboardingComplete    Boolean                @default(false)
    paymentsCustomerId    String?
    locale                String?
    twoFactorEnabled      Boolean?
    sessions              Session[]
    accounts              Account[]
    passkeys              Passkey[]
    invitations           Invitation[]
    purchases             Purchase[]
    members               Member[]
    twofactors            TwoFactor[]
    auditLogs             AuditLog[]
    inventoryTransactions InventoryTransaction[]
    tasks                 WarehouseTask[]
    scanEvents            ScanEvent[]
    uploadedFiles         UploadFile[]           @relation("UploadedFilesByUser")
    ReturnInspection      ReturnInspection[]

    @@unique([email])
    @@unique([username])
    @@map("user")
}

model Session {
    id        String   @id @default(cuid())
    expiresAt DateTime
    ipAddress String?
    userAgent String?
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    impersonatedBy String?

    activeOrganizationId String?

    token     String
    createdAt DateTime
    updatedAt DateTime

    @@unique([token])
    @@index([userId])
    @@index([expiresAt])
    @@map("session")
}

model Account {
    id           String    @id @default(cuid())
    accountId    String
    providerId   String
    userId       String
    user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    accessToken  String?   @db.Text
    refreshToken String?   @db.Text
    idToken      String?   @db.Text
    expiresAt    DateTime?
    password     String?

    accessTokenExpiresAt  DateTime?
    refreshTokenExpiresAt DateTime?
    scope                 String?
    createdAt             DateTime
    updatedAt             DateTime

    @@index([userId])
    @@index([providerId, accountId])
    @@map("account")
}

model Verification {
    id         String   @id @default(cuid())
    identifier String
    value      String   @db.Text
    expiresAt  DateTime

    createdAt DateTime?
    updatedAt DateTime?

    @@index([identifier])
    @@index([expiresAt])
    @@map("verification")
}

model Passkey {
    id           String    @id @default(cuid())
    name         String?
    publicKey    String
    userId       String
    user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    credentialID String    @unique
    counter      Int
    deviceType   String
    backedUp     Boolean
    transports   String?
    createdAt    DateTime?

    @@index([userId])
    @@map("passkey")
}

model TwoFactor {
    id          String @id @default(cuid())
    secret      String
    backupCodes String
    userId      String
    user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@map("two_factor")
}

model Organization {
    id                 String              @id @default(cuid())
    name               String
    slug               String?
    logo               String?
    logoUploadFileId   String?
    logoUploadFile     UploadFile?         @relation("OrganizationLogoUpload", fields: [logoUploadFileId], references: [id], onDelete: SetNull)
    createdAt          DateTime
    metadata           Json?
    paymentsCustomerId String?
    members            Member[]
    invitations        Invitation[]
    purchases          Purchase[]
    roleGroups         RoleGroup[]
    warehouses         Warehouse[]
    orgConfig          OrganizationConfig?
    auditLogs          AuditLog[]
    skus               SKU[]
    suppliers          Supplier[]
    customers          Customer[]
    uploadFiles        UploadFile[]        @relation("OrganizationUploads")
    CustomerLocation   CustomerLocation[]
    Product            Product[]

    @@unique([slug])
    @@index([logoUploadFileId])
    @@map("organization")
}

model OrganizationConfig {
    id             String       @id @default(cuid())
    organizationId String       @unique
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

    headquarterId String?
    headquarter   Address? @relation(fields: [headquarterId], references: [id], onDelete: SetNull)

    fulfillment    Json?
    inventory      Json?
    units          Json?
    barcodeScanner Json?
    purchaseOrders Json?
    transfers      Json?
    cycleCount     Json?
    dataRetention  Json?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("organization_config")
}

model Address {
    id           String  @id @default(cuid())
    addressLine1 String
    addressLine2 String?
    city         String
    state        String
    zip          String
    country      String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    organizationConfigs OrganizationConfig[]
    customerLocations   CustomerLocation[]
    warehouses          Warehouse[]          @relation("WarehouseAddress")
    returnWarehouses    Warehouse[]          @relation("WarehouseReturnAddress")

    @@map("address")
}

model CustomerLocation {
    id             String       @id @default(cuid())
    organizationId String
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

    customerId String
    customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

    addressId String
    address   Address @relation(fields: [addressId], references: [id], onDelete: Cascade)

    name      String
    isDefault Boolean @default(false)
    notes     String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([organizationId])
    @@index([customerId])
    @@map("customer_location")
}

model Member {
    id             String       @id @default(cuid())
    organizationId String
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    userId         String
    user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
    role           String
    roleGroupId    String?
    roleGroup      RoleGroup?   @relation(fields: [roleGroupId], references: [id], onDelete: SetNull)
    createdAt      DateTime

    @@unique([organizationId, userId])
    @@index([userId])
    @@index([roleGroupId])
    @@map("member")
}

model Invitation {
    id             String       @id @default(cuid())
    organizationId String
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    email          String
    role           String?
    status         String
    expiresAt      DateTime
    inviterId      String
    user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

    @@index([organizationId])
    @@index([email])
    @@index([inviterId])
    @@index([expiresAt])
    @@map("invitation")
}

enum PurchaseType {
    SUBSCRIPTION
    ONE_TIME
}

model Purchase {
    id             String        @id @default(cuid())
    organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    organizationId String?
    user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId         String?
    type           PurchaseType
    customerId     String
    subscriptionId String?       @unique
    productId      String
    status         String?
    createdAt      DateTime      @default(now())
    updatedAt      DateTime      @updatedAt

    @@index([subscriptionId])
    @@index([organizationId])
    @@index([userId])
    @@map("purchase")
}

model AuditLog {
    id             String        @id @default(cuid())
    organizationId String?
    organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
    userId         String?
    user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
    action         String
    resource       String
    resourceId     String?
    metadata       Json?
    ipAddress      String?
    userAgent      String?
    createdAt      DateTime      @default(now())

    @@index([organizationId])
    @@index([userId])
    @@index([resource])
    @@index([resourceId])
    @@index([createdAt])
    @@map("audit_log")
}

enum UploadFileScope {
    ORGANIZATION_LOGO
    USER_AVATAR
    NOTE_IMAGE
    GENERIC
}

enum UploadFileStatus {
    PENDING
    UPLOADED
    FAILED
    DELETED
}

model UploadFile {
    id               String           @id @default(cuid())
    organizationId   String?
    organization     Organization?    @relation("OrganizationUploads", fields: [organizationId], references: [id], onDelete: SetNull)
    uploadedByUserId String?
    uploadedByUser   User?            @relation("UploadedFilesByUser", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
    bucket           String           @db.VarChar(100)
    path             String           @db.VarChar(1024)
    fileName         String?          @db.VarChar(255)
    mimeType         String?          @db.VarChar(255)
    sizeBytes        Int?
    checksum         String?          @db.VarChar(255)
    scope            UploadFileScope  @default(GENERIC)
    status           UploadFileStatus @default(PENDING)
    metadata         Json?
    createdAt        DateTime         @default(now())
    updatedAt        DateTime         @updatedAt

    organizationLogoFor Organization[] @relation("OrganizationLogoUpload")

    @@unique([bucket, path])
    @@index([organizationId])
    @@index([uploadedByUserId])
    @@index([scope])
    @@index([status])
    @@map("upload_file")
}

// ================================================
// Scope Models
// ================================================

model RoleGroup {
    id             String       @id @default(cuid())
    createdAt      DateTime     @default(now())
    updatedAt      DateTime     @updatedAt
    organizationId String
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    name           String
    description    String?
    warehouses     Warehouse[]  @relation("RoleGroupWarehouses")
    permissions    String[]
    members        Member[]

    @@index([organizationId])
    @@map("role_group")
}

// ============================================================================
// WAREHOUSE
// ============================================================================

model Warehouse {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    organizationId String
    organization   Organization @relation(fields: [organizationId], references: [id])

    code String
    name String

    timezone String @default("UTC")

    addressId String
    address   Address @relation("WarehouseAddress", fields: [addressId], references: [id])

    sameReturn Boolean

    returnId String?
    return   Address? @relation("WarehouseReturnAddress", fields: [returnId], references: [id])

    status WarehouseStatus @default(ACTIVE)

    locations Location[]
    assets    Asset[]

    inventoryBalances InventoryBalance[]

    receivingOrders ReceivingOrder[]
    salesOrders     SalesOrder[]
    shipments       Shipment[]

    tasks WarehouseTask[]

    purchaseOrders PurchaseOrder[]

    asns AdvancedShippingNotice[]

    workflows WorkflowDefinition[]

    cycleCounts CycleCountSession[]

    returnOrders ReturnOrder[]

    roleGroups           RoleGroup[]            @relation("RoleGroupWarehouses")
    InventoryTransaction InventoryTransaction[]
    PickWave             PickWave[]
    ScanEvent            ScanEvent[]

    @@unique([organizationId, code])
}

enum WarehouseStatus {
    ACTIVE
    INACTIVE
    MAINTENANCE
}

// ============================================================================
// LOCATION
// ============================================================================

model Location {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    warehouseId String
    warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

    parentLocationId String?
    parentLocation   Location? @relation("LocationHierarchy", fields: [parentLocationId], references: [id])

    children Location[] @relation("LocationHierarchy")

    code String
    name String?

    type LocationType

    barcode String? @unique

    sequence Int?

    isPickable   Boolean @default(true)
    isReceivable Boolean @default(true)
    isReservable Boolean @default(true)
    isQuarantine Boolean @default(false)

    capacityVolume Decimal? @db.Decimal(18, 4)
    capacityWeight Decimal? @db.Decimal(18, 4)

    currentVolume Decimal? @db.Decimal(18, 4)
    currentWeight Decimal? @db.Decimal(18, 4)

    // =========================================================================
    // 3D ENGINE SUPPORT
    // =========================================================================

    x Decimal? @db.Decimal(12, 2)
    y Decimal? @db.Decimal(12, 2)
    z Decimal? @db.Decimal(12, 2)

    width  Decimal? @db.Decimal(12, 2)
    height Decimal? @db.Decimal(12, 2)
    depth  Decimal? @db.Decimal(12, 2)

    rotationX Decimal? @db.Decimal(12, 2)
    rotationY Decimal? @db.Decimal(12, 2)
    rotationZ Decimal? @db.Decimal(12, 2)

    meshType String?
    colorHex String?

    inventoryBalances InventoryBalance[]

    replenishmentRules ReplenishmentRule[]

    fromTransactions InventoryTransaction[] @relation("TransactionFromLocation")
    toTransactions   InventoryTransaction[] @relation("TransactionToLocation")

    fromTasks WarehouseTask[] @relation("TaskFromLocation")
    toTasks   WarehouseTask[] @relation("TaskToLocation")

    scanEvents      ScanEvent[]
    InventorySerial InventorySerial[]
    CycleCountItem  CycleCountItem[]

    @@unique([warehouseId, code])
    @@index([warehouseId, type])
    @@index([parentLocationId])
}

enum LocationType {
    FLOOR
    ZONE
    BLOCK
    RACK
    SHELF
    BIN
    PALLET
}

model Asset {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    warehouseId String
    warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

    name String?

    type AssetType

    // =========================================================================
    // 3D ENGINE SUPPORT
    // =========================================================================

    x Decimal? @db.Decimal(12, 2)
    y Decimal? @db.Decimal(12, 2)
    z Decimal? @db.Decimal(12, 2)

    width  Decimal? @db.Decimal(12, 2)
    height Decimal? @db.Decimal(12, 2)
    depth  Decimal? @db.Decimal(12, 2)

    rotationX Decimal? @db.Decimal(12, 2)
    rotationY Decimal? @db.Decimal(12, 2)
    rotationZ Decimal? @db.Decimal(12, 2)

    meshType String?
    colorHex String?

    @@index([warehouseId, type])
}

enum AssetType {
    AISLE
    DOCK_DOOR
    STAIRS
    WALL
}

// ============================================================================
// PRODUCT
// ============================================================================

model Product {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    organizationId String
    organization   Organization @relation(fields: [organizationId], references: [id])

    name String

    description String?

    isPerishable    Boolean @default(false)
    isBatchTracked  Boolean @default(false)
    isSerialTracked Boolean @default(false)

    life Int? @default(0)

    skus SKU[]

    @@unique([organizationId])
}

// ============================================================================
// SKU
// ============================================================================

model SKU {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    productId String
    product   Product @relation(fields: [productId], references: [id])

    code String

    barcode String?

    width  Decimal? @db.Decimal(12, 2)
    height Decimal? @db.Decimal(12, 2)
    length Decimal? @db.Decimal(12, 2)
    weight Decimal? @db.Decimal(12, 2)

    metadata Json?

    unitPrice Decimal? @db.Decimal(18, 4)

    balances InventoryBalance[]
    serials  InventorySerial[]
    lots     InventoryLot[]

    reservations InventoryReservation[]

    purchaseOrderItems PurchaseOrderItem[]
    salesOrderItems    SalesOrderItem[]

    replenishmentRules   ReplenishmentRule[]
    Organization         Organization?          @relation(fields: [organizationId], references: [id])
    organizationId       String?
    InventoryTransaction InventoryTransaction[]
    ASNItem              ASNItem[]
    ReturnOrderItem      ReturnOrderItem[]
    WarehouseTask        WarehouseTask[]
    CycleCountItem       CycleCountItem[]

    @@unique([productId, code])
}

// ============================================================================
// LOT / BATCH
// ============================================================================

model InventoryLot {
    id String @id @default(cuid())

    skuId String
    sku   SKU    @relation(fields: [skuId], references: [id])

    lotNumber String

    manufactureDate DateTime?
    expiryDate      DateTime?

    qcStatus QCStatus @default(PENDING)

    balances             InventoryBalance[]
    InventoryTransaction InventoryTransaction[]

    @@unique([skuId, lotNumber])
}

enum QCStatus {
    PENDING
    PASSED
    FAILED
    HOLD
}

// ============================================================================
// SERIALS
// ============================================================================

model InventorySerial {
    id String @id @default(cuid())

    skuId String
    sku   SKU    @relation(fields: [skuId], references: [id])

    serialNumber String

    locationId String?
    location   Location? @relation(fields: [locationId], references: [id])

    status InventoryState

    @@unique([skuId, serialNumber])
}

// ============================================================================
// INVENTORY BALANCE
// ============================================================================

model InventoryBalance {
    id String @id @default(cuid())

    warehouseId String
    warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

    locationId String
    location   Location @relation(fields: [locationId], references: [id])

    skuId String
    sku   SKU    @relation(fields: [skuId], references: [id])

    lotId String?
    lot   InventoryLot? @relation(fields: [lotId], references: [id])

    state InventoryState @default(AVAILABLE)

    quantityAvailable Decimal @default(0) @db.Decimal(18, 4)
    quantityReserved  Decimal @default(0) @db.Decimal(18, 4)
    quantityDamaged   Decimal @default(0) @db.Decimal(18, 4)
    quantityInbound   Decimal @default(0) @db.Decimal(18, 4)

    updatedAt DateTime @updatedAt

    @@unique([locationId, skuId, lotId, state])
    @@index([warehouseId, skuId])
    @@index([locationId, skuId])
}

enum InventoryState {
    AVAILABLE
    RESERVED
    QC
    HOLD
    DAMAGED
    QUARANTINE
    EXPIRED
    INBOUND
    OUTBOUND
}

// ============================================================================
// INVENTORY RESERVATIONS
// ============================================================================

model InventoryReservation {
    id String @id @default(cuid())

    skuId String
    sku   SKU    @relation(fields: [skuId], references: [id])

    salesOrderItemId String?
    salesOrderItem   SalesOrderItem? @relation(fields: [salesOrderItemId], references: [id])

    quantity Decimal @db.Decimal(18, 4)

    status ReservationStatus

    createdAt DateTime @default(now())

    @@index([skuId])
}

enum ReservationStatus {
    ACTIVE
    RELEASED
    CONSUMED
}

// ============================================================================
// INVENTORY TRANSACTION
// ============================================================================

model InventoryTransaction {
    id String @id @default(cuid())

    createdAt DateTime @default(now())

    warehouseId String
    warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

    skuId String
    sku   SKU    @relation(fields: [skuId], references: [id])

    lotId String?
    lot   InventoryLot? @relation(fields: [lotId], references: [id])

    fromLocationId String?
    fromLocation   Location? @relation("TransactionFromLocation", fields: [fromLocationId], references: [id])

    toLocationId String?
    toLocation   Location? @relation("TransactionToLocation", fields: [toLocationId], references: [id])

    quantity Decimal @db.Decimal(18, 4)

    transactionType InventoryTransactionType

    referenceType String?
    referenceId   String?

    performedById String?
    performedBy   User?   @relation(fields: [performedById], references: [id])

    metadata Json?

    @@index([warehouseId, createdAt])
    @@index([skuId, createdAt])
}

enum InventoryTransactionType {
    RECEIVE
    PUTAWAY
    PICK
    PACK
    SHIP
    MOVE
    ADJUSTMENT
    CYCLE_COUNT
    RETURN
    DAMAGE
    REPLENISHMENT
}

// ============================================================================
// SUPPLIERS
// ============================================================================

model Supplier {
    id String @id @default(cuid())

    organizationId String
    organization   Organization @relation(fields: [organizationId], references: [id])

    code String
    name String

    email    String?
    phone    String?
    metadata Json?

    createdAt DateTime @default(now())

    purchaseOrders PurchaseOrder[]
    asns           AdvancedShippingNotice[]

    @@unique([organizationId, code])
}

// ============================================================================
// ASN
// ============================================================================

model AdvancedShippingNotice {
    id String @id @default(cuid())

    warehouseId String
    warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

    supplierId String
    supplier   Supplier @relation(fields: [supplierId], references: [id])

    purchaseOrderId String?
    purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

    asnNumber String

    expectedArrival DateTime?

    pallets Int?
    cartons Int?

    status ASNStatus

    createdAt DateTime @default(now())

    items          ASNItem[]
    ReceivingOrder ReceivingOrder[]

    @@unique([warehouseId, asnNumber])
}

model ASNItem {
    id String @id @default(cuid())

    asnId String
    asn   AdvancedShippingNotice @relation(fields: [asnId], references: [id])

    skuId String
    sku   SKU    @relation(fields: [skuId], references: [id])

    expectedQty Decimal @db.Decimal(18, 4)
    receivedQty Decimal @default(0) @db.Decimal(18, 4)

    lotNumber String?
}

enum ASNStatus {
    CREATED
    IN_TRANSIT
    ARRIVED
    RECEIVING
    COMPLETED
    CANCELLED
}

// ============================================================================
// PURCHASE ORDER
// ============================================================================

model PurchaseOrder {
    id String @id @default(cuid())

    warehouseId String
    warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

    supplierId String
    supplier   Supplier @relation(fields: [supplierId], references: [id])

    poNumber String

    status PurchaseOrderStatus

    expectedAt DateTime?

    items PurchaseOrderItem[]

    asns AdvancedShippingNotice[]

    createdAt      DateTime         @default(now())
    ReceivingOrder ReceivingOrder[]

    @@unique([warehouseId, poNumber])
}

enum PurchaseOrderStatus {
    DRAFT
    APPROVED
    IN_TRANSIT
    PARTIAL
    RECEIVED
    CANCELLED
}

model PurchaseOrderItem {
    id String @id @default(cuid())

    purchaseOrderId String
    purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

    skuId String
    sku   SKU    @relation(fields: [skuId], references: [id])

    orderedQty  Decimal @db.Decimal(18, 4)
    receivedQty Decimal @default(0) @db.Decimal(18, 4)

    unitPrice Decimal? @db.Decimal(18, 4)
}

// ============================================================================
// RECEIVING
// ============================================================================

model ReceivingOrder {
    id String @id @default(cuid())

    warehouseId String
    warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

    purchaseOrderId String?
    purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

    asnId String?
    asn   AdvancedShippingNotice? @relation(fields: [asnId], references: [id])

    status ReceivingStatus

    receivedAt DateTime?

    createdAt DateTime @default(now())
}

enum ReceivingStatus {
    PENDING
    RECEIVING
    COMPLETED
    CANCELLED
}

// ============================================================================
// CUSTOMER
// ============================================================================

model Customer {
    id String @id @default(cuid())

    organizationId String
    organization   Organization @relation(fields: [organizationId], references: [id])

    code String
    name String

    email        String?
    phone        String?
    notes        String?
    isWholesaler Boolean @default(false)
    metadata     Json?

    createdAt DateTime @default(now())

    salesOrders      SalesOrder[]
    returnOrders     ReturnOrder[]
    CustomerLocation CustomerLocation[]

    @@unique([organizationId, code])
}

// ============================================================================
// SALES ORDER
// ============================================================================

model SalesOrder {
    id String @id @default(cuid())

    warehouseId String
    warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

    customerId String
    customer   Customer @relation(fields: [customerId], references: [id])

    orderNumber String

    status SalesOrderStatus

    orderedAt DateTime @default(now())

    items SalesOrderItem[]

    shipment    Shipment?
    ReturnOrder ReturnOrder[]

    @@unique([warehouseId, orderNumber])
}

enum SalesOrderStatus {
    DRAFT
    ALLOCATED
    PICKING
    PACKING
    SHIPPED
    CANCELLED
}

model SalesOrderItem {
    id String @id @default(cuid())

    salesOrderId String
    salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id])

    skuId String
    sku   SKU    @relation(fields: [skuId], references: [id])

    orderedQty   Decimal @db.Decimal(18, 4)
    allocatedQty Decimal @default(0) @db.Decimal(18, 4)
    pickedQty    Decimal @default(0) @db.Decimal(18, 4)

    reservations InventoryReservation[]
}

// ============================================================================
// SHIPMENT
// ============================================================================

model Shipment {
    id String @id @default(cuid())

    warehouseId String
    warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

    salesOrderId String     @unique
    salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id])

    shipmentNumber String

    trackingNumber String?

    carrier String?

    dockDoorId String?

    scheduledAt DateTime?

    notes String?

    shippedAt DateTime?

    status ShipmentStatus

    @@unique([warehouseId, shipmentNumber])
}

enum ShipmentStatus {
    PENDING
    PACKED
    SHIPPED
    DELIVERED
    FAILED
}

// ============================================================================
// REVERSE LOGISTICS
// ============================================================================

model ReturnOrder {
    id String @id @default(cuid())

    warehouseId String
    warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

    customerId String
    customer   Customer @relation(fields: [customerId], references: [id])

    salesOrderId String?
    salesOrder   SalesOrder? @relation(fields: [salesOrderId], references: [id])

    returnNumber String

    reason String?

    status ReturnOrderStatus

    createdAt DateTime @default(now())

    items ReturnOrderItem[]

    inspections ReturnInspection[]

    @@unique([warehouseId, returnNumber])
}

model ReturnOrderItem {
    id String @id @default(cuid())

    returnOrderId String
    returnOrder   ReturnOrder @relation(fields: [returnOrderId], references: [id])

    skuId String
    sku   SKU    @relation(fields: [skuId], references: [id])

    quantity Decimal @db.Decimal(18, 4)

    disposition ReturnDisposition?
}

model ReturnInspection {
    id String @id @default(cuid())

    returnOrderId String
    returnOrder   ReturnOrder @relation(fields: [returnOrderId], references: [id])

    inspectedById String?
    inspectedBy   User?   @relation(fields: [inspectedById], references: [id])

    result QCStatus

    notes String?

    createdAt DateTime @default(now())
}

enum ReturnDisposition {
    RESTOCK
    SCRAP
    REFURBISH
    RETURN_TO_VENDOR
}

enum ReturnOrderStatus {
    CREATED
    IN_TRANSIT
    RECEIVED
    INSPECTING
    COMPLETED
    CANCELLED
}

// ============================================================================
// WAVE PICKING
// ============================================================================

model PickWave {
    id String @id @default(cuid())

    warehouseId String
    warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

    waveNumber String

    status WaveStatus

    tasks WarehouseTask[]

    createdAt DateTime @default(now())

    @@unique([warehouseId, waveNumber])
}

enum WaveStatus {
    CREATED
    RELEASED
    PICKING
    COMPLETED
}

// ============================================================================
// TASK ENGINE
// ============================================================================

model WarehouseTask {
    id String @id @default(cuid())

    warehouseId String
    warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

    assignedUserId String?
    assignedUser   User?   @relation(fields: [assignedUserId], references: [id])

    pickWaveId String?
    pickWave   PickWave? @relation(fields: [pickWaveId], references: [id])

    type WarehouseTaskType

    status TaskStatus

    priority TaskPriority

    fromLocationId String?
    fromLocation   Location? @relation("TaskFromLocation", fields: [fromLocationId], references: [id])

    toLocationId String?
    toLocation   Location? @relation("TaskToLocation", fields: [toLocationId], references: [id])

    skuId String?
    sku   SKU?    @relation(fields: [skuId], references: [id])

    quantity Decimal? @db.Decimal(18, 4)

    startedAt   DateTime?
    completedAt DateTime?

    createdAt DateTime @default(now())

    @@index([warehouseId, status])
}

enum WarehouseTaskType {
    RECEIVE
    PUTAWAY
    PICK
    PACK
    SHIP
    MOVE
    REPLENISHMENT
    CYCLE_COUNT
    QC
}

enum TaskStatus {
    PENDING
    ASSIGNED
    IN_PROGRESS
    COMPLETED
    CANCELLED
}

enum TaskPriority {
    LOW
    NORMAL
    HIGH
    URGENT
}

// ============================================================================
// WORKFLOW ENGINE
// ============================================================================

model WorkflowDefinition {
    id String @id @default(cuid())

    warehouseId String
    warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

    name String

    type WorkflowType

    version Int @default(1)

    isActive Boolean @default(true)

    nodes WorkflowNode[]
    edges WorkflowEdge[]

    createdAt DateTime @default(now())

    executions WorkflowExecution[]
}

model WorkflowNode {
    id String @id @default(cuid())

    workflowId String
    workflow   WorkflowDefinition @relation(fields: [workflowId], references: [id])

    nodeId String

    type String

    label String

    positionX Decimal @db.Decimal(12, 2)
    positionY Decimal @db.Decimal(12, 2)

    metadata Json?
}

model WorkflowEdge {
    id String @id @default(cuid())

    workflowId String
    workflow   WorkflowDefinition @relation(fields: [workflowId], references: [id])

    sourceNodeId String
    targetNodeId String

    label String?

    metadata Json?
}

model WorkflowExecution {
    id String @id @default(cuid())

    workflowId String
    workflow   WorkflowDefinition @relation(fields: [workflowId], references: [id])

    referenceType String?
    referenceId   String?

    status WorkflowExecutionStatus

    startedAt   DateTime  @default(now())
    completedAt DateTime?

    steps WorkflowExecutionStep[]
}

model WorkflowExecutionStep {
    id String @id @default(cuid())

    executionId String
    execution   WorkflowExecution @relation(fields: [executionId], references: [id])

    nodeId String

    status WorkflowExecutionStatus

    startedAt   DateTime  @default(now())
    completedAt DateTime?

    metadata Json?
}

enum WorkflowType {
    INBOUND
    OUTBOUND
    INVENTORY
    RETURNS
}

enum WorkflowExecutionStatus {
    PENDING
    RUNNING
    COMPLETED
    FAILED
    CANCELLED
}

// ============================================================================
// REPLENISHMENT
// ============================================================================

model ReplenishmentRule {
    id String @id @default(cuid())

    locationId String
    location   Location @relation(fields: [locationId], references: [id])

    skuId String
    sku   SKU    @relation(fields: [skuId], references: [id])

    minQty       Decimal @db.Decimal(18, 4)
    maxQty       Decimal @db.Decimal(18, 4)
    replenishQty Decimal @db.Decimal(18, 4)

    @@unique([locationId, skuId])
}

// ============================================================================
// CYCLE COUNT
// ============================================================================

model CycleCountSession {
    id String @id @default(cuid())

    warehouseId String
    warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

    status CycleCountStatus

    createdAt DateTime @default(now())

    items CycleCountItem[]
}

model CycleCountItem {
    id String @id @default(cuid())

    sessionId String
    session   CycleCountSession @relation(fields: [sessionId], references: [id])

    locationId String
    location   Location @relation(fields: [locationId], references: [id])

    skuId String
    sku   SKU    @relation(fields: [skuId], references: [id])

    expectedQty Decimal @db.Decimal(18, 4)
    countedQty  Decimal @db.Decimal(18, 4)

    variance Decimal @db.Decimal(18, 4)
}

enum CycleCountStatus {
    CREATED
    COUNTING
    APPROVED
    COMPLETED
}

// ============================================================================
// SCAN EVENTS
// ============================================================================

model ScanEvent {
    id String @id @default(cuid())

    warehouseId String
    warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

    userId String?
    user   User?   @relation(fields: [userId], references: [id])

    locationId String?
    location   Location? @relation(fields: [locationId], references: [id])

    barcode String

    eventType ScanEventType

    metadata Json?

    createdAt DateTime @default(now())

    @@index([warehouseId, createdAt])
}

enum ScanEventType {
    RECEIVE
    PICK
    PUTAWAY
    MOVE
    PACK
    SHIP
    COUNT
}
