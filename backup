// ================================================
// Scope Models
// ================================================

model RoleGroup {
    id             String       @id @default(cuid())
    createdAt      DateTime     @default(now())
    updatedAt      DateTime     @updatedAt
    organizationId String
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    name           String
    description    String
    warehouses     Warehouse[]
    roles          String[]

    @@map("role_group")
}

// ================================================
// Common Models
// ================================================
model Address {
    id           String   @id @default(cuid())
    addressLine1 String
    addressLine2 String?
    city         String
    country      String
    state        String
    zip          String
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    warehouse       Warehouse?          @relation("WarehouseAddress")
    warehouseReturn Warehouse?          @relation("WarehouseReturnAddress")
    orgConfig       OrganizationConfig? @relation("OrgConfigHeadquarter")

    @@map("address")
}

model Task {
    id           String   @id @default(cuid())
    description  String
    assignedToId String
    assignedTo   User     @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
    assignedById String
    assignedBy   User     @relation("TaskAssignedBy", fields: [assignedById], references: [id])
    deadline     DateTime
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    @@map("task")
}

model Barcode {
    id        String   @id @default(cuid())
    metadata  Json
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("barcode")
}

// ================================================
// ENUMS
// ================================================
enum InventoryStatus {
    AVAILABLE
    RESERVED
    DAMAGED
    QC_HOLD
    RETURNED
}

// ================================================
// Functional Models.
// ================================================

model OrganizationConfig {
    id             String   @id @default(cuid())
    headquarterId  String   @unique
    headquarter    Address  @relation("OrgConfigHeadquarter", fields: [headquarterId], references: [id])
    fullfilment    Json
    inventory      Json
    units          Json
    barcodeScanner Json
    purchaseOrders Json
    transfers      Json
    cycleCount     Json
    dataRetention  Json
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    @@map("organization_config")
}

model Warehouse {
    id              String     @id @default(cuid())
    name            String
    prefix          String
    phone           String
    managerId       String
    manager         User       @relation(fields: [managerId], references: [id])
    addressId       String     @unique
    address         Address    @relation("WarehouseAddress", fields: [addressId], references: [id])
    returnAddressId String     @unique
    returnAddress   Address    @relation("WarehouseReturnAddress", fields: [returnAddressId], references: [id])
    roleGroupId     String?
    roleGroup       RoleGroup? @relation(fields: [roleGroupId], references: [id])
    createdAt       DateTime   @default(now())
    updatedAt       DateTime   @updatedAt

    @@map("warehouse")
}

model Shelf {
    id          String    @id @default(cuid())
    name        String
    description String
    startX      Float
    startY      Float
    length      Float
    width       Float
    height      Float
    isObstacle  Boolean
    pickSides   Boolean[]
    bins        Bin[]
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    @@map("shelf")
}

model Area {
    id          String   @id @default(cuid())
    name        String
    description String
    startX      Float
    startY      Float
    length      Float
    width       Float
    isObstacle  Boolean
    color       String
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@map("area")
}

model Bin {
    id          String   @id @default(cuid())
    name        String
    description String
    shelfId     String
    shelf       Shelf    @relation(fields: [shelfId], references: [id])
    level       Int
    isPickable  Boolean
    startX      Float
    startY      Float
    length      Float
    width       Float
    height      Float
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@map("bin")
}

model StorageLocation {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    warehouseId String
    warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

    zoneId String
    zone   Zone   @relation(fields: [zoneId], references: [id])

    // Self hierarchy
    parentLocationId String?
    parentLocation      StorageLocation? @relation(
    "LocationHierarchy",
    fields: [parentLocationId],
    references       id[]
    )

    childLocations StorageLocation[] @relation("LocationHierarchy")

    code    String
    barcode String?

    name String?

    type   StorageLocationType
    status StorageLocationStatus @default(ACTIVE)

    maxWeightKg Float?
    maxVolumeM3 Float?

    maxPallets Int?
    maxUnits   Int?

    allowMixedSku   Boolean @default(false)
    allowMixedBatch Boolean @default(false)

    sortOrder Int?

    handlingUnits  HandlingUnit[]
    inventoryItems InventoryItem[]

    @@unique([warehouseId, code])
    @@index([warehouseId])
    @@index([zoneId])
    @@index([parentLocationId])
    @@index([type])
    @@index([status])
}

model Border {
    id        String   @id @default(cuid())
    name      String
    startX    Float
    startY    Float
    endX      Float
    endY      Float
    type      String // Wall | Door
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("border")
}

// ================================================
// Product Models.
// ================================================

model Product {
    id         String   @id @default(cuid())
    name       String
    tags       String[]
    type       String // Digital | Physical
    perishable Boolean
    status     String // Active, Draft, Archived
    metadata   Json?
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt
}

model SKU {
    id             String   @id @default(cuid())
    product        Product
    code           String
    price          Float
    metadata       Json?
    options        Json?
    height         Float
    width          Float
    length         Float
    weight         Float
    serialTracking Boolean  @default(false)
    batchTracking  Boolean  @default(false)
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt
}

model InventoryItem {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    skuId String
    sku   SKU    @relation(fields: [skuId], references: [id])

    //   locationId          String
    //   location            StorageLocation @relation(
    //     fields: [locationId],
    //     references: [id]
    //   )

    //   handlingUnitId      String?
    //   handlingUnit        HandlingUnit? @relation(
    //     fields: [handlingUnitId],
    //     references: [id]
    //   )

    serialNumber String?
    batchNumber  String?

    quantity Int

    metadata Json?

    inventoryStatus InventoryStatus @default(AVAILABLE)

    @@index([skuId])
    //   @@index([locationId])
    //   @@index([handlingUnitId])
    @@index([serialNumber])
    @@index([batchNumber])
    @@index([inventoryStatus])
}
